@model IEnumerable<MovieBooking.Models.Movie>

@{
    ViewData["Title"] = ViewBag.Title ?? "Danh Sách Phim";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0">🎬 @ViewData["Title"]</h2>

        <div class="d-flex gap-2 flex-wrap align-items-center">
            <div class="btn-group" role="group">
                <a asp-action="Index" class="btn btn-outline-primary">Tất cả</a>
                <a asp-action="NowShowing" class="btn btn-outline-success">Đang chiếu</a>
                <a asp-action="ComingSoon" class="btn btn-outline-warning">Sắp chiếu</a>
            </div>

            @if (Context.Session.GetString("Role") == "Admin")
            {
                <a asp-area="Admin" asp-controller="Movie" asp-action="Create" class="btn btn-dark">+ Thêm phim</a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h5 class="mb-2">Hiện chưa có phim nào trong danh mục này.</h5>
            <p class="text-muted mb-0">Vui lòng quay lại sau!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <div class="position-relative" style="height: 340px; background-color: #212529;">
                            @if (!string.IsNullOrEmpty(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="@movie.Title" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-white-50">
                                    <span>Chưa có poster</span>
                                </div>
                            }
                            <span class="badge position-absolute top-0 end-0 m-2 @(movie.Status == "Showing" || movie.Status == "NowShowing" ? "bg-success" : "bg-warning text-dark")">
                                @(movie.Status == "Showing" || movie.Status == "NowShowing" ? "Đang chiếu" : "Sắp chiếu")
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate" title="@movie.Title">@movie.Title</h5>
                            <div class="mb-2">
                                @foreach (var genre in movie.Genres)
                                {
                                    <span class="badge bg-light text-dark border me-1">@genre.GenreName</span>
                                }
                            </div>
                            <p class="card-text text-muted small mb-3">
                                ⏱️ @movie.Duration phút | 🌐 @movie.Language | 🔞 @movie.AgeRating
                            </p>
                            <div class="mt-auto">
                                <a asp-action="Details" asp-route-id="@movie.MovieId" class="btn btn-primary w-100">Xem Chi Tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
