@model MovieBooking.DTOs.MovieFormDto

@{
    ViewData["Title"] = "Thêm phim";
    var genres = ViewBag.Genres as IEnumerable<MovieBooking.Models.Genre> ?? Enumerable.Empty<MovieBooking.Models.Genre>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">🎬 Thêm phim mới</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>

    <form asp-action="Create" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-md-8">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="Coming Soon">Sắp chiếu</option>
                <option value="Showing">Đang chiếu</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <div class="col-md-3">
            <label asp-for="Duration" class="form-label"></label>
            <input asp-for="Duration" class="form-control" type="number" min="1" />
            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="ReleaseDate" class="form-label"></label>
            <input asp-for="ReleaseDate" class="form-control" type="date" />
        </div>

        <div class="col-md-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" />
        </div>

        <div class="col-md-3">
            <label asp-for="AgeRating" class="form-label"></label>
            <input asp-for="AgeRating" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="Director" class="form-label"></label>
            <input asp-for="Director" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="Language" class="form-label"></label>
            <input asp-for="Language" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="Actors" class="form-label"></label>
            <input asp-for="Actors" class="form-control" />
        </div>

        <div class="col-md-6">
            <label asp-for="PosterUrl" class="form-label"></label>
            <input asp-for="PosterUrl" class="form-control" />
            <span asp-validation-for="PosterUrl" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="TrailerUrl" class="form-label"></label>
            <input asp-for="TrailerUrl" class="form-control" />
            <span asp-validation-for="TrailerUrl" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="GenreIds" class="form-label"></label>
            <div class="row row-cols-2 row-cols-md-4 g-2">
                @foreach (var genre in genres)
                {
                    <div class="col">
                        <label class="d-flex align-items-center gap-2 border rounded p-2 bg-light">
                            <input type="checkbox" name="GenreIds" value="@genre.GenreId" />
                            <span>@genre.GenreName</span>
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 mt-4">
            <button type="submit" class="btn btn-primary px-4">Lưu phim</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
