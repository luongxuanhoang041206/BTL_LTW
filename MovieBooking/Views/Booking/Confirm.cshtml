@model MovieBooking.DTOs.BookingConfirmViewModel
@{
    ViewData["Title"] = "Xác nhận đặt vé";
    var expiresIso = Model.HoldExpiresAt.ToString("o");
}

<div class="container py-4" style="max-width: 780px;">
    <h4 class="fw-bold mb-4">🎟️ Xác nhận đặt vé</h4>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Countdown -->
    <div class="alert alert-warning d-flex align-items-center gap-3 mb-4" id="countdownAlert">
        <span class="fs-4">⏳</span>
        <div>
            <strong>Thời gian giữ ghế còn lại:</strong>
            <span id="countdownDisplay" class="fs-5 fw-bold text-danger ms-2">--:--</span>
            <div class="small text-muted">Vui lòng xác nhận trước khi hết giờ.</div>
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT: booking summary -->
        <div class="col-md-7">
            <!-- Showtime info -->
            <div class="card border-0 shadow-sm rounded-3 mb-3">
                <div class="card-header bg-primary text-white fw-semibold rounded-top-3">
                    📽️ Thông tin suất chiếu
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted w-40">Phim</td>
                                <td class="fw-bold">@Model.MovieTitle</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Ngày chiếu</td>
                                <td>@Model.ShowDate.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Giờ chiếu</td>
                                <td>@Model.StartTime.ToString("HH:mm")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Rạp</td>
                                <td>@Model.CinemaName</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Phòng</td>
                                <td>@Model.RoomName <span class="badge bg-secondary ms-1">@Model.RoomType</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Seats -->
            <div class="card border-0 shadow-sm rounded-3 mb-3">
                <div class="card-header bg-light fw-semibold">
                    💺 Ghế đã chọn (@Model.HeldSeats.Count ghế)
                </div>
                <div class="card-body pb-2">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var seat in Model.HeldSeats)
                        {
                            var badgeColor = seat.SeatType switch {
                                "VIP"    => "bg-primary",
                                "Couple" => "bg-danger",
                                _        => "bg-success"
                            };
                            <span class="badge @badgeColor fs-6 px-3 py-2">
                                @seat.SeatLabel
                                <small class="opacity-75 ms-1">@seat.SeatType</small>
                            </span>
                        }
                    </div>
                </div>
            </div>

            @{
                var availableCombos = ViewBag.AvailableCombos as List<MovieBooking.DTOs.ComboDto> ?? new List<MovieBooking.DTOs.ComboDto>();
            }
            @if (availableCombos.Any())
            {
                <!-- Combos selection -->
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                        <span>🍿 Chọn thêm Bắp Nước & Combo</span>
                        <span class="badge bg-danger">Ưu đãi kèm vé</span>
                    </div>
                    <div class="card-body p-2">
                        @foreach (var c in availableCombos)
                        {
                            <div class="d-flex align-items-center justify-content-between border-bottom py-2 px-2 combo-row" data-id="@c.ComboId" data-price="@c.Price">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                    {
                                        <img src="@c.ImageUrl" class="rounded object-fit-cover" style="width: 48px; height: 48px;" onerror="this.src='/images/placeholder-combo.png';" />
                                    }
                                    else
                                    {
                                        <span class="fs-4">🍱</span>
                                    }
                                    <div>
                                        <div class="fw-bold small">@c.Name</div>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">
                                            @string.Join(", ", c.Items.Select(i => $"{i.Quantity}x {i.FoodItemName}"))
                                        </small>
                                        <div class="text-danger small fw-bold">@c.Price.ToString("N0") ₫</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-combo-minus" style="width: 28px; height: 28px; padding: 0;">-</button>
                                    <input type="number" class="form-control form-control-sm text-center combo-qty" style="width: 42px;" value="0" min="0" max="20" readonly />
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-combo-plus" style="width: 28px; height: 28px; padding: 0;">+</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Promo code -->
            <div class="card border-0 shadow-sm rounded-3 mb-3">
                <div class="card-header bg-light fw-semibold">🏷️ Mã giảm giá</div>
                <div class="card-body">
                    <div class="input-group">
                        <input type="text" id="promoInput" class="form-control text-uppercase"
                               placeholder="Nhập mã (VD: GIAM20)"
                               value="@Model.AppliedPromoCode"
                               maxlength="30" />
                        <button class="btn btn-outline-primary" type="button" id="applyPromoBtn">
                            Áp dụng
                        </button>
                    </div>
                    <div id="promoMsg" class="mt-2 small"></div>
                    <input type="hidden" id="appliedPromoCode" value="@Model.AppliedPromoCode" />
                    <input type="hidden" id="discountPercent"  value="@Model.DiscountPercent" />
                </div>
            </div>
        </div>

        <!-- RIGHT: order total + confirm -->
        <div class="col-md-5">
            <div class="card border-0 shadow rounded-3 sticky-top" style="top: 80px;">
                <div class="card-header bg-primary text-white fw-semibold rounded-top-3">
                    💳 Tổng đơn hàng
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted">Số ghế</td>
                                <td class="text-end fw-semibold">@Model.HeldSeats.Count ghế</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Đơn giá</td>
                                <td class="text-end">@Model.PricePerSeat.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Tạm tính</td>
                                <td class="text-end" id="displaySubtotal">
                                    @Model.SubTotal.ToString("N0") ₫
                                </td>
                            </tr>
                            <tr id="discountRow" style="@(Model.DiscountPercent > 0 ? "" : "display:none")">
                                <td class="text-muted text-success">
                                    Giảm giá (<span id="displayDiscPct">@Model.DiscountPercent</span>%)
                                </td>
                                <td class="text-end text-success fw-semibold" id="displayDiscAmt">
                                    -@Model.DiscountAmount.ToString("N0") ₫
                                </td>
                            </tr>
                            <tr class="border-top">
                                <td class="fw-bold fs-6 pt-2">Tổng cộng</td>
                                <td class="text-end fw-bold fs-5 text-primary pt-2" id="displayTotal">
                                    @Model.TotalAmount.ToString("N0") ₫
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-white border-0 pb-3 px-3">
                    <form method="post" asp-action="Confirm" id="confirmForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ShowtimeId" value="@Model.ShowtimeId" />
                        <input type="hidden" name="PromoCode"  id="formPromoCode"
                               value="@Model.AppliedPromoCode" />
                        <button type="submit" class="btn btn-primary btn-lg w-100" id="confirmBtn">
                            ✅ Xác nhận đặt vé
                        </button>
                    </form>
                    <a asp-controller="Booking" asp-action="SelectSeat"
                       asp-route-showtimeId="@Model.ShowtimeId"
                       class="btn btn-outline-secondary w-100 mt-2">
                        ← Chọn lại ghế
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // ── Countdown timer ──────────────────────────────────────────────
    const expiresAt   = new Date('@expiresIso');
    const displayEl   = document.getElementById('countdownDisplay');
    const alertEl     = document.getElementById('countdownAlert');
    const confirmBtn  = document.getElementById('confirmBtn');

    function tick() {
        const remaining = Math.floor((expiresAt - Date.now()) / 1000);
        if (remaining <= 0) {
            displayEl.textContent = '00:00';
            alertEl.classList.remove('alert-warning');
            alertEl.classList.add('alert-danger');
            confirmBtn.disabled = true;
            alert('⏰ Thời gian giữ ghế đã hết! Bạn sẽ được chuyển về trang chọn ghế.');
            window.location.href = '@Url.Action("SelectSeat", "Booking", new { showtimeId = Model.ShowtimeId })';
            return;
        }
        const m = String(Math.floor(remaining / 60)).padStart(2, '0');
        const s = String(remaining % 60).padStart(2, '0');
        displayEl.textContent = `${m}:${s}`;
        if (remaining <= 60) {
            displayEl.classList.add('text-danger');
            alertEl.classList.add('alert-danger');
            alertEl.classList.remove('alert-warning');
        }
        setTimeout(tick, 1000);
    }
    tick();

    // ── Price recalculation ──────────────────────────────────────────
    const seatSubTotal  = @Model.HeldSeats.Sum(seat => seat.Price);

    function getCombosTotal() {
        let sum = 0;
        document.querySelectorAll('.combo-row').forEach(row => {
            const price = parseFloat(row.getAttribute('data-price')) || 0;
            const qty = parseInt(row.querySelector('.combo-qty').value, 10) || 0;
            sum += price * qty;
        });
        return sum;
    }

    function recalc(discPct) {
        const comboTotal = getCombosTotal();
        const subTotal   = seatSubTotal + comboTotal;
        const disc       = Math.round(seatSubTotal * discPct / 100);
        const total      = subTotal - disc;

        document.getElementById('displaySubtotal').textContent =
            subTotal.toLocaleString('vi-VN') + ' ₫';
        document.getElementById('displayDiscPct').textContent  = discPct;
        document.getElementById('displayDiscAmt').textContent  =
            '-' + disc.toLocaleString('vi-VN') + ' ₫';
        document.getElementById('displayTotal').textContent    =
            total.toLocaleString('vi-VN') + ' ₫';

        document.getElementById('discountRow').style.display = discPct > 0 ? '' : 'none';
    }

    // Event listeners cho các nút tăng giảm combo
    document.querySelectorAll('.btn-combo-plus').forEach(btn => {
        btn.addEventListener('click', function () {
            const row = this.closest('.combo-row');
            const input = row.querySelector('.combo-qty');
            let val = parseInt(input.value, 10) || 0;
            if (val < 20) {
                input.value = val + 1;
                recalc(parseFloat(document.getElementById('discountPercent').value) || 0);
            }
        });
    });

    document.querySelectorAll('.btn-combo-minus').forEach(btn => {
        btn.addEventListener('click', function () {
            const row = this.closest('.combo-row');
            const input = row.querySelector('.combo-qty');
            let val = parseInt(input.value, 10) || 0;
            if (val > 0) {
                input.value = val - 1;
                recalc(parseFloat(document.getElementById('discountPercent').value) || 0);
            }
        });
    });

    // Khi submit form confirm, đính kèm các combo đã chọn
    document.getElementById('confirmForm').addEventListener('submit', function () {
        // Xóa hidden inputs cũ nếu có
        this.querySelectorAll('.dynamic-combo-input').forEach(el => el.remove());

        let idx = 0;
        document.querySelectorAll('.combo-row').forEach(row => {
            const id = row.getAttribute('data-id');
            const qty = parseInt(row.querySelector('.combo-qty').value, 10) || 0;
            if (qty > 0) {
                const inputId = document.createElement('input');
                inputId.type = 'hidden';
                inputId.name = `Combos[${idx}].ComboId`;
                inputId.value = id;
                inputId.className = 'dynamic-combo-input';
                this.appendChild(inputId);

                const inputQty = document.createElement('input');
                inputQty.type = 'hidden';
                inputQty.name = `Combos[${idx}].Quantity`;
                inputQty.value = qty;
                inputQty.className = 'dynamic-combo-input';
                this.appendChild(inputQty);

                idx++;
            }
        });
    });

    recalc(parseFloat(document.getElementById('discountPercent').value) || 0);

    // ── Apply promo via AJAX ─────────────────────────────────────────
    document.getElementById('applyPromoBtn').addEventListener('click', async function () {
        const code    = document.getElementById('promoInput').value.trim().toUpperCase();
        const msgEl   = document.getElementById('promoMsg');
        const token   = document.querySelector('input[name="__RequestVerificationToken"]').value;

        if (!code) {
            msgEl.innerHTML = '<span class="text-danger">Vui lòng nhập mã giảm giá.</span>';
            return;
        }

        msgEl.innerHTML = '<span class="text-muted">Đang kiểm tra...</span>';

        try {
            const res  = await fetch('@Url.Action("ApplyPromo", "Booking")', {
                method: 'POST',
                headers: {
                    'Content-Type':             'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'promoCode=' + encodeURIComponent(code)
            });
            const data = await res.json();

            if (data.success) {
                msgEl.innerHTML =
                    `<span class="text-success">✔ ${data.description ?? ''} — Giảm ${data.discountPercent}%</span>`;
                document.getElementById('appliedPromoCode').value = data.code;
                document.getElementById('formPromoCode').value    = data.code;
                document.getElementById('discountPercent').value  = data.discountPercent;
                recalc(data.discountPercent);
            } else {
                msgEl.innerHTML = `<span class="text-danger">${data.error}</span>`;
                document.getElementById('appliedPromoCode').value = '';
                document.getElementById('formPromoCode').value    = '';
                document.getElementById('discountPercent').value  = 0;
                recalc(0);
            }
        } catch {
            msgEl.innerHTML = '<span class="text-danger">Lỗi kết nối. Vui lòng thử lại.</span>';
        }
    });

    // Allow Enter key in promo input
    document.getElementById('promoInput').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); document.getElementById('applyPromoBtn').click(); }
    });
})();
</script>
}
