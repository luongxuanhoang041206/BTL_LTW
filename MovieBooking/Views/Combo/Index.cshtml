@model IEnumerable<MovieBooking.DTOs.ComboDto>

@{
    ViewData["Title"] = "Quản lý Combo";
    var selectedIsActive = ViewBag.SelectedIsActive as bool?;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">🍱 Quản lý Combo Bắp Nước</h2>
            <p class="text-muted mb-0">Quản lý các gói combo tiết kiệm kết hợp bắp rang và đồ uống</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Combo" asp-action="Create" class="btn btn-primary">
                ➕ Tạo Combo mới
            </a>
            <a asp-area="Admin" asp-controller="FoodItem" asp-action="Index" class="btn btn-outline-dark ms-2">
                🍿 Quản lý Món lẻ
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <span>✅ @TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span>⚠️ @TempData["Error"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bộ lọc trạng thái -->
    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Trạng thái áp dụng</label>
                    <select name="isActive" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="true" selected="@(selectedIsActive == true ? "selected" : null)">Đang áp dụng</option>
                        <option value="false" selected="@(selectedIsActive == false ? "selected" : null)">Tạm ngưng áp dụng</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-50">Lọc dữ liệu</button>
                    <a asp-area="Admin" asp-controller="Combo" asp-action="Index" class="btn btn-outline-secondary w-50">Xóa lọc</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách combo -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card shadow-sm border-0 py-5 text-center text-muted">
                    Chưa có combo nào hoặc không tìm thấy combo phù hợp.
                </div>
            </div>
        }
        else
        {
            @foreach (var combo in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <div class="position-absolute top-0 end-0 m-2">
                            @if (combo.IsActive)
                            {
                                <span class="badge bg-success">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Tạm ngưng</span>
                            }
                        </div>

                        <div class="text-center pt-3 px-3">
                            @if (!string.IsNullOrWhiteSpace(combo.ImageUrl))
                            {
                                <img src="@combo.ImageUrl" alt="@combo.Name" class="card-img-top rounded object-fit-cover" style="height: 180px;" onerror="this.src='/images/placeholder-combo.png';" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center mx-auto" style="height: 180px; font-size: 3.5rem;">
                                    🍱
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@combo.Name</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(string.IsNullOrWhiteSpace(combo.Description) ? "Combo bắp nước hấp dẫn" : combo.Description)
                            </p>

                            <div class="mb-3">
                                <span class="fw-bold small text-uppercase text-secondary">Thành phần (@combo.Items.Count món):</span>
                                <ul class="list-unstyled mb-0 mt-1 small">
                                    @foreach (var item in combo.Items)
                                    {
                                        <li class="d-flex justify-content-between text-muted border-bottom py-1">
                                            <span>• @item.FoodItemName</span>
                                            <span class="badge bg-light text-dark border">x@item.Quantity</span>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    <small class="text-muted d-block">Giá combo:</small>
                                    <span class="h5 fw-bold text-danger mb-0">@combo.Price.ToString("N0") đ</span>
                                </div>
                                <form asp-area="Admin" asp-controller="Combo" asp-action="ToggleStatus" asp-route-id="@combo.ComboId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(combo.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        @(combo.IsActive ? "Tắt" : "Bật")
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex gap-2 justify-content-end">
                            <a asp-area="Admin" asp-controller="Combo" asp-action="Details" asp-route-id="@combo.ComboId" class="btn btn-sm btn-outline-info">Chi tiết</a>
                            <a asp-area="Admin" asp-controller="Combo" asp-action="Edit" asp-route-id="@combo.ComboId" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-area="Admin" asp-controller="Combo" asp-action="Delete" asp-route-id="@combo.ComboId" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
