@model MovieBooking.DTOs.ComboDto

@{
    ViewData["Title"] = "Xóa Combo - " + Model.Name;
    bool canDelete = ViewBag.CanDelete as bool? ?? false;
    string? reason = ViewBag.Reason as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-danger mb-1">🗑️ Xóa Gói Combo</h2>
            <p class="text-muted mb-0">Xác nhận thao tác xóa combo khỏi hệ thống</p>
        </div>
        <a asp-area="Admin" asp-controller="Combo" asp-action="Index" class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    @if (!canDelete)
    {
        <div class="alert alert-warning shadow-sm border-0" role="alert">
            <h5 class="alert-heading fw-bold">⚠️ Không thể xóa gói Combo này!</h5>
            <p class="mb-2">@reason</p>
            <hr>
            <div class="d-flex gap-2">
                <form asp-area="Admin" asp-controller="Combo" asp-action="ToggleStatus" asp-route-id="@Model.ComboId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        ⏸️ @(Model.IsActive ? "Tạm ngưng bán combo này (Tắt IsActive)" : "Kích hoạt lại")
                    </button>
                </form>
                <a asp-area="Admin" asp-controller="Combo" asp-action="Index" class="btn btn-secondary">Về danh sách</a>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Thông tin combo:</h5>
            <dl class="row mb-4">
                <dt class="col-sm-3 text-muted">Tên combo:</dt>
                <dd class="col-sm-9 fw-bold">@Model.Name</dd>

                <dt class="col-sm-3 text-muted">Giá bán:</dt>
                <dd class="col-sm-9 text-danger fw-bold">@Model.Price.ToString("N0") đ</dd>

                <dt class="col-sm-3 text-muted">Trạng thái:</dt>
                <dd class="col-sm-9">@(Model.IsActive ? "Đang bán" : "Tạm ngưng")</dd>

                <dt class="col-sm-3 text-muted">Thành phần:</dt>
                <dd class="col-sm-9">
                    <ul class="mb-0">
                        @foreach (var it in Model.Items)
                        {
                            <li>@it.FoodItemName (Số lượng: @it.Quantity)</li>
                        }
                    </ul>
                </dd>
            </dl>

            @if (canDelete)
            {
                <div class="alert alert-danger py-2 mb-3">
                    Bạn có chắc chắn muốn xóa vĩnh viễn gói combo này? Toàn bộ danh sách thành phần liên quan sẽ bị xóa!
                </div>

                <form asp-area="Admin" asp-controller="Combo" asp-action="Delete" asp-route-id="@Model.ComboId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ComboId" />
                    <button type="submit" class="btn btn-danger px-4">Xác nhận xóa</button>
                    <a asp-area="Admin" asp-controller="Combo" asp-action="Index" class="btn btn-outline-secondary ms-2 px-4">Hủy</a>
                </form>
            }
        </div>
    </div>
</div>
