@model MovieBooking.DTOs.ComboDto

@{
    ViewData["Title"] = "Chi tiết Combo - " + Model.Name;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">🔍 Chi Tiết Gói Combo</h2>
            <p class="text-muted mb-0">Xem thành phần món và giá bán của combo</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Combo" asp-action="Edit" asp-route-id="@Model.ComboId" class="btn btn-primary">
                ✏️ Sửa combo
            </a>
            <a asp-area="Admin" asp-controller="Combo" asp-action="Index" class="btn btn-outline-secondary ms-2">
                Quay lại
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded mb-3 shadow-sm" style="max-height: 280px; object-fit: cover;" onerror="this.src='/images/placeholder-combo.png';" />
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 200px; height: 200px; font-size: 4rem;">
                            🍱
                        </div>
                    }
                    <h4 class="fw-bold">@Model.Name</h4>
                    <div class="mb-2">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success fs-6">Đang kinh doanh</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Tạm ngừng bán</span>
                        }
                    </div>
                    <div class="display-6 fw-bold text-danger my-3">
                        @Model.Price.ToString("N0") <small class="fs-5 text-muted">đ</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold py-3">
                    📝 Mô tả combo
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Không có mô tả chi tiết." : Model.Description)
                    </p>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span>🍿 Các món trong combo</span>
                    <span class="badge bg-primary">@Model.Items.Count món</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Món</th>
                                    <th>Đơn giá món lẻ</th>
                                    <th>Số lượng</th>
                                    <th class="text-end">Thành tiền món lẻ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    decimal totalRetailPrice = 0;
                                }
                                @foreach (var item in Model.Items)
                                {
                                    var sub = item.FoodItemPrice * item.Quantity;
                                    totalRetailPrice += sub;
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.FoodItemName</div>
                                        </td>
                                        <td>@item.FoodItemPrice.ToString("N0") đ</td>
                                        <td><span class="badge bg-secondary fs-6">x @item.Quantity</span></td>
                                        <td class="text-end fw-bold">@sub.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="fw-bold text-end">Tổng giá trị món lẻ:</td>
                                    <td class="text-end fw-bold">@totalRetailPrice.ToString("N0") đ</td>
                                </tr>
                                <tr class="table-success">
                                    <td colspan="3" class="fw-bold text-end">Giá bán gói Combo:</td>
                                    <td class="text-end fw-bold text-danger fs-5">@Model.Price.ToString("N0") đ</td>
                                </tr>
                                @if (totalRetailPrice > Model.Price)
                                {
                                    <tr>
                                        <td colspan="3" class="text-end text-success fw-bold">Tiết kiệm cho khách hàng:</td>
                                        <td class="text-end text-success fw-bold">- @((totalRetailPrice - Model.Price).ToString("N0")) đ</td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
