@model MovieBooking.DTOs.ComboFormDto

@{
    ViewData["Title"] = "Tạo Combo mới";
    var foodItems = ViewBag.ActiveFoodItems as List<MovieBooking.DTOs.FoodItemDto> ?? new List<MovieBooking.DTOs.FoodItemDto>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">➕ Tạo Combo Bắp Nước Mới</h2>
            <p class="text-muted mb-0">Thiết lập gói combo gồm nhiều món ăn, đồ uống và giá bán ưu đãi</p>
        </div>
        <a asp-area="Admin" asp-controller="Combo" asp-action="Index" class="btn btn-outline-secondary">
            ⬅️ Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-area="Admin" asp-controller="Combo" asp-action="Create" method="post" id="comboForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Combo 2 Người (1 Bắp + 2 Nước)" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="Price" class="form-control" type="number" step="1000" min="0" placeholder="99000" />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label fw-bold"></label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/combo.jpg hoặc /images/..." />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Ghi chú chi tiết về combo, ưu đãi tiết kiệm..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked />
                            <label class="form-check-label fw-bold" for="isActiveSwitch">
                                Kích hoạt bán combo này ngay sau khi tạo
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Quản lý thành phần combo -->
                <div class="border rounded p-3 mb-4 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-0">🍿 Thành phần của Combo</h5>
                            <small class="text-muted">Chọn các món thành phần và chỉ định số lượng tương ứng</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-success" id="btnAddItem">
                            ➕ Thêm món thành phần
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle bg-white" id="itemsTable">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Món ăn / Đồ uống</th>
                                    <th style="width: 150px;">Số lượng</th>
                                    <th style="width: 90px;" class="text-center">Xóa</th>
                                </tr>
                            </thead>
                            <tbody id="itemsTableBody">
                                @if (Model.SelectedItems != null && Model.SelectedItems.Any())
                                {
                                    for (int i = 0; i < Model.SelectedItems.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <select name="SelectedItems[@i].FoodItemId" class="form-select food-select" required>
                                                    <option value="">-- Chọn món --</option>
                                                    @foreach (var f in foodItems)
                                                    {
                                                        <option value="@f.FoodItemId" selected="@(Model.SelectedItems[i].FoodItemId == f.FoodItemId ? "selected" : null)">
                                                            @f.Name (@f.Category) - @f.Price.ToString("N0") đ
                                                        </option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input type="number" name="SelectedItems[@i].Quantity" class="form-control" value="@Model.SelectedItems[i].Quantity" min="1" max="100" required />
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row">🗑️</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td>
                                            <select name="SelectedItems[0].FoodItemId" class="form-select food-select" required>
                                                <option value="">-- Chọn món --</option>
                                                @foreach (var f in foodItems)
                                                {
                                                    <option value="@f.FoodItemId">@f.Name (@f.Category) - @f.Price.ToString("N0") đ</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" name="SelectedItems[0].Quantity" class="form-control" value="1" min="1" max="100" required />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row">🗑️</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-area="Admin" asp-controller="Combo" asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">💾 Lưu Combo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            const foodOptionsHtml = `@foreach (var f in foodItems) {
                <text><option value="@f.FoodItemId">@f.Name (@f.Category) - @f.Price.ToString("N0") đ</option></text>
            }`;

            function reindexRows() {
                $('#itemsTableBody tr').each(function (index) {
                    $(this).find('.food-select').attr('name', `SelectedItems[${index}].FoodItemId`);
                    $(this).find('input[type="number"]').attr('name', `SelectedItems[${index}].Quantity`);
                });
            }

            $('#btnAddItem').on('click', function () {
                const rowCount = $('#itemsTableBody tr').length;
                const newRow = `
                    <tr>
                        <td>
                            <select name="SelectedItems[${rowCount}].FoodItemId" class="form-select food-select" required>
                                <option value="">-- Chọn món --</option>
                                ${foodOptionsHtml}
                            </select>
                        </td>
                        <td>
                            <input type="number" name="SelectedItems[${rowCount}].Quantity" class="form-control" value="1" min="1" max="100" required />
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row">🗑️</button>
                        </td>
                    </tr>
                `;
                $('#itemsTableBody').append(newRow);
            });

            $(document).on('click', '.btn-remove-row', function () {
                if ($('#itemsTableBody tr').length <= 1) {
                    alert('Combo phải có ít nhất 1 món thành phần!');
                    return;
                }
                $(this).closest('tr').remove();
                reindexRows();
            });
        });
    </script>
}
