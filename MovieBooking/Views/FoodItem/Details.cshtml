@model MovieBooking.Models.FoodItem

@{
    ViewData["Title"] = "Chi tiết món - " + Model.Name;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">🔍 Chi Tiết Món Ăn</h2>
            <p class="text-muted mb-0">Xem thông tin chi tiết và danh sách Combo có chứa món này</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="FoodItem" asp-action="Edit" asp-route-id="@Model.FoodItemId" class="btn btn-primary">
                ✏️ Sửa món
            </a>
            <a asp-area="Admin" asp-controller="FoodItem" asp-action="Index" class="btn btn-outline-secondary ms-2">
                Quay lại
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded mb-3 shadow-sm" style="max-height: 280px; object-fit: cover;" onerror="this.src='/images/placeholder-food.png';" />
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 200px; height: 200px; font-size: 4rem;">
                            🍿
                        </div>
                    }
                    <h4 class="fw-bold">@Model.Name</h4>
                    <div class="mb-2">
                        <span class="badge bg-secondary fs-6">@Model.Category</span>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success fs-6">Đang bán</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Ngừng bán</span>
                        }
                    </div>
                    <div class="display-6 fw-bold text-success my-3">
                        @Model.Price.ToString("N0") <small class="fs-5 text-muted">đ</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white fw-bold py-3">
                    📝 Mô tả sản phẩm
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Không có mô tả chi tiết." : Model.Description)
                    </p>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span>🍱 Đang nằm trong các Combo</span>
                    <span class="badge bg-primary">@Model.ComboDetails.Count combo</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.ComboDetails.Any())
                    {
                        <div class="p-3 text-muted">
                            Món này chưa được thêm vào bất kỳ combo nào.
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var cd in Model.ComboDetails)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <a asp-area="Admin" asp-controller="Combo" asp-action="Details" asp-route-id="@cd.ComboId" class="fw-bold text-decoration-none">
                                            @cd.Combo.Name
                                        </a>
                                        <small class="text-muted d-block">Giá combo: @cd.Combo.Price.ToString("N0") đ</small>
                                    </div>
                                    <span class="badge bg-info text-dark">Số lượng: @cd.Quantity</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
