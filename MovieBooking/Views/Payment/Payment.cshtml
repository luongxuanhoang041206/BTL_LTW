@model MovieBooking.DTOs.PaymentViewModel

@{
    ViewData["Title"] = "Thanh toán đơn hàng";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Xác nhận thanh toán</h4>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <p>Mã đơn hàng: <strong>#@Model.BookingId</strong></p>
            <p>Tổng số tiền cần thanh toán: <strong class="text-danger" style="font-size: 1.3rem;">@Model.TotalAmount.ToString("N0") VNĐ</strong></p>
            <hr />

            <form asp-controller="Payment" asp-action="ProcessPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BookingId" value="@Model.BookingId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Chọn phương thức thanh toán:</label>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="Method" id="vnpay" value="VNPAY" checked>
                        <label class="form-check-label" for="vnpay">
                            <strong>VNPay</strong> (Quét mã QR / Thẻ nội địa / Visa)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="Method" id="momo" value="MOMO">
                        <label class="form-check-label" for="momo">
                            <strong>Ví điện tử MoMo</strong>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-success btn-lg w-100">Tiến hành thanh toán</button>
            </form>
        </div>
    </div>
</div>