@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="alert alert-danger p-5 shadow-sm">
            <h1 class="display-4 text-danger"><i class="bi bi-shield-lock-fill"></i> 403</h1>
            <h3 class="mb-3">Từ chối truy cập (Access Denied)</h3>
            <p class="text-muted">Bạn không có quyền truy cập vào tài nguyên hoặc chức năng này. Chức năng yêu cầu quyền Quản trị viên (Admin).</p>
            <hr class="my-4">
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Về trang chủ</a>
                <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">Đăng nhập tài khoản khác</a>
            </div>
        </div>
    </div>
</div>
